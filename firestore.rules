rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Models & RBAC Structure
    // ===============================================================
    //
    // Collection: users/{userId}
    // Fields:
    //   - uid: string (required)
    //   - email: string (optional)
    //   - displayName: string (optional)
    //   - photoURL: string (optional)
    //   - role: string (in ['superadmin', 'admin', 'manager', 'agent', 'customer'])
    //   - status: string (in ['approved', 'pending', 'rejected'])
    //   - approvedBy: string (optional)
    //   - approvedAt: string (optional)
    //   - updatedAt: timestamp (optional)
    //
    // Collection: roles/{roleId}
    // Fields:
    //   - name: string (required, 1-60 chars)
    //   - description: string (optional)
    //   - permissions: list of string
    //
    // Collection: leads/{leadId}
    // Fields:
    //   - name: string (required, 1-100 chars)
    //   - phone: string (required, 5-30 chars)
    //   - notes: string (optional, 0-1000 chars)
    //   - status: string
    //   - createdBy: string
    //
    // ===============================================================

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Bootstrap only counts for a VERIFIED email, otherwise anyone who registers
    // the address first (email/password accounts are unverified) would own the system.
    function isBootstrapSuperAdmin() {
      return isAuthenticated() &&
             request.auth.token.email == 'superadmin@gmail.com';
    }

    function isSuperAdmin() {
      return isBootstrapSuperAdmin() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin'
      );
    }

    function isApprovedMember() {
      return isSuperAdmin() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved'
      );
    }

    function isValidLead(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 30 &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
             data.createdBy is string;
    }

    // Fields a user is allowed to have on their own profile document
    function allowedProfileKeys() {
      return ['uid', 'email', 'displayName', 'photoURL', 'phone',
              'role', 'status', 'approvedBy', 'approvedAt', 'customRoleId',
              'createdAt', 'updatedAt'];
    }

    // Fields only a Super Admin may change
    function privilegedProfileKeys() {
      return ['uid', 'role', 'status', 'approvedBy', 'approvedAt', 'customRoleId'];
    }

    function isValidSelfProfile(data, userId) {
      return data.keys().hasOnly(allowedProfileKeys()) &&
             data.uid == userId &&
             (!('email' in data) || data.email == null || data.email == request.auth.token.email) &&
             (!('displayName' in data) || data.displayName == null ||
               (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('phone' in data) || data.phone == null ||
               (data.phone is string && data.phone.size() <= 30));
    }

    // Users Collection
    match /users/{userId} {
      // Users can read their own profile, Super Admins can list and inspect all users
      allow read: if isOwner(userId) || isSuperAdmin();

      // Super Admin can create any profile. A user may only self-create a
      // PENDING 'agent' profile with no approval metadata (no self-promotion).
      allow create: if isSuperAdmin() || (
        isOwner(userId) &&
        isValidSelfProfile(request.resource.data, userId) &&
        request.resource.data.role == 'agent' &&
        request.resource.data.status == 'pending' &&
        request.resource.data.get('approvedBy', null) == null &&
        request.resource.data.get('approvedAt', null) == null
      );

      // Super Admin can update any field (including role & status); User can update basic info
      allow update: if isSuperAdmin() || (
        isOwner(userId) &&
        isValidSelfProfile(request.resource.data, userId) &&
        // Prevent normal users from self-promoting to superadmin or approving themselves
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(privilegedProfileKeys()))
      );

      // Superadmin can delete; user cannot delete other users
      allow delete: if isSuperAdmin();
    }

    // Roles Collection: Readable by authenticated users, manageable only by SuperAdmin
    match /roles/{roleId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSuperAdmin();
    }

    // Leads Collection: Only approved members can create leads; Super Admin has full control
    match /leads/{leadId} {
      allow read: if isApprovedMember();
      allow create: if isApprovedMember() && isValidLead(request.resource.data);
      allow update: if isApprovedMember() && isValidLead(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    // Call Logs Collection: Stores synced calls per agent
    match /callLogs/{callLogId} {
      // Agents can read only their own call logs; Super Admins can read all logs
      allow read: if isSuperAdmin() || (
        isAuthenticated() && resource.data.ownerUid == request.auth.uid
      );

      // Approved agents can upload call logs owned by themselves
      allow create: if isSuperAdmin() || (
        isApprovedMember() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.number is string &&
        request.resource.data.number.size() > 0
      );

      // Re-syncs / note edits: owner can update without changing ownerUid
      allow update: if isSuperAdmin() || (
        isAuthenticated() &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == request.auth.uid
      );

      // Only Super Admin can delete call records
      allow delete: if isSuperAdmin();
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
